<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SyncBookPlayer.View.AddBook"
             Title="Добавить книгу">
    <VerticalStackLayout VerticalOptions="Center" Margin="20,0,20,0">
        <Label Text="Введите ссылку на видео в это поле:"/>
        <Entry x:Name="vidurl"/>
        <Button Clicked="Button_Clicked" Text="Найти видео" WidthRequest="180" Margin="0,10" x:Name="findbut"/>
        <Label x:Name="title" HorizontalOptions="Center" Margin="0,0,0,15"/>
        <Image x:Name="preview" MaximumWidthRequest="400"/>
        <ProgressBar x:Name="downloadprog" HeightRequest="10" Margin="0,15,0,0"/>
        <Button Clicked="Button_Clicked_1" IsEnabled="False" Text="Скачать видео" WidthRequest="180" Margin="0,10" x:Name="downbut"/>
        
    </VerticalStackLayout>
</ContentPage>